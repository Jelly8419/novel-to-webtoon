# 이 파일을 .env.local 로 복사해서 값을 채우세요. .env.local 은 절대 커밋하지 않습니다.

# mock: 가짜 응답(비용 0원, 기본값) / live: 실제 API 호출
AI_MODE=mock

# 텍스트 처리 (장면 분할, 콘티) · OpenAI
LLM_API_KEY=
# 비워두면 gpt-6-luna. 가격표: src/lib/ai/pricing.ts
LLM_MODEL=gpt-6-luna

# 이미지 생성 (FLUX 계열 API)
IMAGE_API_KEY=
IMAGE_MODEL=flux-1-schnell

# 카카오 로그인 (Auth.js)
AUTH_SECRET=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
